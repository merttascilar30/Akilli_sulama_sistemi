<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DESENI" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_DIZINI" value="logs"/>

    <!-- Konsola tum INFO ve uzeri seviyedeki loglari basar -->
    <appender name="KONSOL" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_DESENI}</pattern>
        </encoder>
    </appender>

    <!-- Genel uygulama loglarini gunluk/boyutsal olarak donen dosyaya yazar -->
    <appender name="DOSYA" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIZINI}/akilli-sulama-backend.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_DESENI}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIZINI}/archive/akilli-sulama-backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- GlobalExceptionHandler tarafindan uretilen WARN/ERROR seviyeli hata loglarini ayri bir dosyada tutar -->
    <appender name="HATA_DOSYASI" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIZINI}/akilli-sulama-backend-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_DESENI}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIZINI}/archive/akilli-sulama-backend-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="com.example.backend" level="INFO" additivity="false">
        <appender-ref ref="KONSOL"/>
        <appender-ref ref="DOSYA"/>
        <appender-ref ref="HATA_DOSYASI"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="KONSOL"/>
        <appender-ref ref="DOSYA"/>
    </root>

</configuration>
